# Copy to .env and fill in. Find your light with:
#   docker compose run --rm mergbw python mergbw.py scan

# MAC address of the light (required)
MERGBW_MAC=AA:BB:CC:DD:EE:FF

# Device type reported by `scan` (1 = addressable strip / letters / hexagon, 2 = RGB strip, ...)
MERGBW_TYPE=1

# Address the HTTP API listens on. Keep 127.0.0.1 if Homebridge runs on the same
# machine; use 0.0.0.0 only on a trusted network (the API has no authentication).
MERGBW_HOST=127.0.0.1
MERGBW_PORT=8790

# Seconds of inactivity before the Bluetooth connection is released (lets the phone app connect)
MERGBW_IDLE_TIMEOUT=20

# Seconds between re-reading power/brightness from the light (0 = never)
MERGBW_POLL_INTERVAL=300
